                "box": {
                    "code": "// op@ v4.0\n// 6.9.2025 by cora hausch \n// hausch@moozak.org\n// rampsmooth implementation by Mauricio Giri\n\ncalc(mode, a, b) {\n\tresult = 0;\n\n\tif (mode == 0) {\n\t\tresult = 0;\n\t}\telse if (mode == 1) {\n\t\tresult = a;\n\t}\telse if (mode == 2) {\n\t\tresult = b;\n\t} \telse if (mode == 3) {\n\t\tresult = a + b;\n\t} \telse if (mode == 4) {\n\t\tresult = a - b;\n\t}\telse if (mode == 5) {\n\t\tresult = a * b;\n\t}\telse if (mode == 6) {\n\t\tresult = a / b;\n\t}\telse if (mode == 7) {\n\t\tresult = a % b;\n\t}\telse if (mode == 8) {\n\t\tresult = absdiff(a, b);\n\t}\telse if (mode == 9) {\n\t\tresult = minimum(a, b);\n\t}\telse if (mode == 10) {\n\t\tresult = maximum(a, b);\n\t}\telse if (mode == 11) {\n\t\tresult = (a+b)/2;\n\t}\telse if (mode == 12) {\n\t\tresult = and(a, b);\n\t}\telse if (mode == 13) {\n\t\tresult = or(a, b);\n\t}\telse if (mode == 14) {\n\t\tresult = xor(a, b);\n\t}\telse if (mode == 15) {\n\t\tresult = not(a, b);\n\t}\telse if (mode == 16) {\n\t\tresult = a == b;\n\t}\telse if (mode == 17) {\n\t\tresult = a ==p b;\n\t}\telse if (mode == 18) {\n\t\tresult = a > b;\n\t}\telse if (mode == 19) {\n\t\tresult = a >= b;\n\t}\telse if (mode == 20) {\n\t\tresult = a >p b;\n\t}\telse if (mode == 21) {\n\t\tresult = a >=p b;\n\t}\telse if (mode == 22) {\n\t\tresult = a < b;\n\t}\telse if (mode == 23) {\n\t\tresult = a <= b;\n\t}\telse if (mode == 24) {\n\t\tresult = a <p b;\n\t}\telse if (mode == 25) {\n\t\tresult = a <=p b;\n\t}\telse if (mode == 26) {\n\t\tresult = sah(a, b, 0.5);\n\t}\telse if (mode == 27) {\n\t\tresult = pow(a, b); // a to the power of b\n\t}\telse if (mode == 28) {\n\t\tresult = pow(a, 1 / b); // b-root of a\n\t}\telse if (mode == 29) {\n\t\tresult = log(a) / log(b); // log of a to the base b\n\t}\telse if (mode == 30) {\n\t\tresult = sin(a) * b;\n\t}\telse if (mode == 31) {\n\t\tresult = cos(a) * b;\n\t}\telse if (mode == 32) {\n\t\tresult = sin(a + b);\n\t}\telse if (mode == 33) {\n\t\tresult = cos(a + b);\n\t}\telse if (mode == 34) {\n\t\tresult = sin(a * b);\n\t}\telse if (mode == 35) {\n\t\tresult = cos(a * b);\n\t}\n\treturn result;\n\t\n}\n\nscaleval(value, scaleInMin, scaleInMax, scaleOutMin, scaleOutMax, scaleExpVal, scaleSym) {\n\tresult = 0;\n\tif (scaleSym == 0) {\n\t\tresult = scale(value, scaleInMin, scaleInMax, scaleOutMin, scaleOutMax, scaleExpVal);\n\t} else if (scaleSym == 1) {\n\t\tinMid = scaleInMax - scaleInMin;\n \t\toutMid = scaleOutMax - scaleOutMin;\n\t\tif (value > 0) {\n\t\t\tresult = scale(value, inMid, scaleInMax, outMid, scaleOutMax, scaleExpVal);\n\t\t} else if (value < 0) {\n\t\t\tresult = -1 * scale(abs(value), inMid, abs(scaleInMin), outMid, abs(scaleOutMin), scaleExpVal);\n\t\t} else {\n\t\t\tresult = 0;\n\t\t}\n\t} else if (scaleSym == 2) {\n\t\tinMid = ((scaleInMax - scaleInMin)/2) + scaleInMin;\n \t\toutMid = ((scaleOutMax - scaleOutMin)/2) + scaleOutMin;\n\t\tif (value > inMid) {\n\t\t\tresult = scale(value, inMid, scaleInMax, outMid, scaleOutMax, scaleExpVal);\n\t\t} else if (value < inMid) {\n\t\t\tresult = -1 * scale(abs(value), inMid, abs(scaleInMin), outMid, abs(scaleOutMin), scaleExpVal);\n\t\t} else if (value == inMid) {\n\t\t\tresult = outMid;\n\t\t}\n\t}\n\treturn result;\n}\n\nclipval(value, clipMin, clipMax, clipMode) {\n\tresult = 0;\n\tif (clipMode == 1) {\n\t\tresult = clip(value, clipMin, clipMax);\n\t} else if (clipMode == 2) {\n\t\tresult = wrap(value, clipMin, clipMax);\n\t} else if (clipMode == 3) {\n\t\tresult = fold(value, clipMin, clipMax);\n\t} else if (clipMode == 4) {\n\t\tpreClipScale = scale(value, -1, 1, 1/clipMin, 1/clipMax, 1);\n\t\tresult = scale(tanh(preClipScale), -1, 1, clipMin, clipMax, 1);\n\t}\n\treturn result;\n}\n\nrampsmooth(input, rampUp, rampDown) {\n\tHistory value, prev, stepcounter, increment;\n\n\t// reset ramp if input has changed, or if ramp parameters change:\n\tif (input != prev || delta(rampUp) || delta(rampDown)) {\n\t\tdirection = (input - value);\n\t\tif (direction > 0) {\n\t\t\tstepcounter = rampUp;\n\t\t\tincrement = direction / rampUp;\n\t\t} else {\n\t\t\tstepcounter = rampDown;\n\t\t\tincrement = direction / rampDown;\n\t\t}\n\t\tprev = input;\t\n\t}\n\n\t// keep incrementing until stepcounter counts down to zero\n\tif (stepcounter) {\n\t\tstepcounter -= 1;\n\t\tvalue += increment;\n\t} else {\n\t\tvalue = input;\n\t}\n\n\treturn value;\n}\n\n// parameters\n\nParam operator(0);\nParam switchOps(0, min=0, max=1);\nParam dcBlockPostOp(0, min=0, max=1);\nParam dcBlockPostScale(0, min=0, max=1);\nParam scaleMode(0, min=0, max=1);\nParam scaleInMin(-1);\nParam scaleInMax(1);\nParam scaleOutMin(-1);\nParam scaleOutMax(1);\nParam scaleExpVal(1);\nParam scaleSym(0, min=0, max=2);\nParam clipMode(0, min=0, max=4);\nParam clipMin(-1);\nParam clipMax(1);\nParam smoothMode(0, min=0, max=1);\nParam smoothUp(0, min=0);\nParam smoothDown(0, min=0);\nParam pRampMs(10);\nParam roundMode(0, min=0, max=1);\nParam roundPos(0);\n\n// set up parameter caches\nHistory scaleInMin_prev(0);\nHistory scaleInMax_prev(0);\nHistory scaleOutMin_prev(0);\nHistory scaleOutMax_prev(0);\nHistory scaleExpVal_prev(0);\nHistory clipMin_prev(0);\nHistory clipMax_prev(0);\n\nleft, right = in1, in2;\n\npRamp = mstosamps(pRampMs);\n\n// processing\na = switchOps ? right : left;\nb = switchOps ? left : right;\n\nscaleInMin_changed = (scaleInMin_prev != scaleInMin);\nscaleInMax_changed = (scaleInMax_prev != scaleInMax);\nscaleOutMin_changed = (scaleOutMin_prev != scaleOutMin);\nscaleOutMax_changed = (scaleOutMax_prev != scaleOutMax);\nscaleExpVal_changed = (scaleExpVal_prev != scaleExpVal);\nclipMin_changed = (clipMin_prev != clipMin);\nclipMax_changed = (clipMax_prev != clipMax);\n\nscaleInMin_smoothed, scaleInMax_smoothed, scaleOutMin_smoothed, scaleOutMax_smoothed, scaleExpVal_smoothed, clipMin_smoothed, clipMax_smoothed = scaleInMin_prev, scaleInMax_prev, scaleOutMin_prev, scaleOutMax_prev, scaleExpVal_prev, clipMin_prev, clipMax_prev;\n\nif (scaleInMin_changed || scaleInMax_changed || scaleOutMin_changed || scaleOutMax_changed || scaleExpVal_changed || clipMin_changed || clipMax_changed) {\n\tscaleInMin_smoothed = rampsmooth(scaleInMin, pRamp, pRamp);\n\tscaleInMax_smoothed = rampsmooth(scaleInMax, pRamp, pRamp);\n\tscaleOutMin_smoothed = rampsmooth(scaleOutMin, pRamp, pRamp);\n\tscaleOutMax_smoothed = rampsmooth(scaleOutMax, pRamp, pRamp);\n\tscaleExpVal_smoothed = rampsmooth(scaleExpVal, pRamp, pRamp);\n\tclipMin_smoothed = rampsmooth(clipMin, pRamp, pRamp);\n\tclipMax_smoothed = rampsmooth(clipMax, pRamp, pRamp);\n\tsmoothUp_smoothed = rampsmooth(smoothUp, pRamp, pRamp);\n\tsmoothDown_smoothed = rampsmooth(smoothDown, pRamp, pRamp);\n}\n\nresult = fixnan(calc(operator, a, b));\nresultDcBlocked = dcBlockPostOp ? dcblock(result) : result;\nresultScaled = scaleMode ? scaleval(resultDcBlocked, scaleInMin_smoothed, scaleInMax_smoothed, scaleOutMin_smoothed, scaleOutMax_smoothed, scaleExpVal_smoothed, scaleSym) : resultDcBlocked;\nresultDcBlockedScaled = dcBlockPostScale ? dcblock(resultScaled) : resultScaled;\nresultClipped = clipMode ? clipval(resultDcBlockedScaled, clipMin_smoothed, clipMax_smoothed, clipMode) : resultDcBlockedScaled;\nresultRounded = roundMode ? round(resultClipped, roundPos) : resultClipped;\nresultSmoothed = smoothMode ? rampsmooth(resultRounded, smoothUp, smoothDown) : resultRounded;\n\nout1 = resultSmoothed;\n\n// Cache parameters\nscaleInMin_prev = scaleInMin;\nscaleInMax_prev = scaleInMax;\nscaleOutMin_prev = scaleOutMin;\nscaleOutMax_prev = scaleOutMax;\nscaleExpVal_prev = scaleExpVal;\nclipMin_prev = clipMin;\nclipMax_prev = clipMax;\n\nlPreSig_prev = lPreSig;\nrPreSig_prev = rPreSig;\ndcBlockPreA_prev = dcBlockPreA;\ndcBlockPreB_prev = dcBlockPreB;\nlAbsPlus_prev = lAbsPlus;\nlAbsMinus_prev = lAbsMinus;\nrAbsPlus_prev = rAbsPlus;\nrAbsMinus_prev = rAbsMinus;\n",

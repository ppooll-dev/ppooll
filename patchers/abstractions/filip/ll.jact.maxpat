                            },
                            {
                                "box": {
                                    "code": "var ll_global = new Global(\"ppooll\");\r\n\r\nfunction add_matrix(a){\r\n    if (!ll_global.matrix) ll_global[\"matrix\"] = {};\r\n    if (!ll_global.matrix[a]) ll_global.matrix[a] = {};\r\n}\r\n\r\nfunction delete_matrix(a){\r\n    delete ll_global.matrix[a];\r\n}\r\n\r\nfunction get_matrix(){\r\n    let keys = Object.keys(ll_global.matrix);\r\n    post(\"ppooll matrices:\", keys,\"\\n\");\r\n}",
                                    "filename": "none",

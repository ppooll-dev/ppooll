                "box": {
                    "code": "// get channels from ho_st1\r\n\r\nvar ll_global = new Global(\"ppooll\");\r\n\r\nfunction bang() { loadbang() }\r\n\r\nfunction loadbang(){\r\n    if(\r\n        !ll_global.patchers || \r\n        ll_global.patchers.ho_st1\r\n    ) post(\"ppooll~ : ho_st1 not loaded yet...\\n\")\r\n    \r\n    const chans = ll_global.patchers.ho_st1\r\n        .getnamed(\"chans\")\r\n        .getvalueof();\r\n        \r\n    outlet(0, chans);\r\n    \r\n}",

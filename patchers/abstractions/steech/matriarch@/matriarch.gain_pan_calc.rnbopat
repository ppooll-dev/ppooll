            },
            {
                "box": {
                    "code": "let vols : list = listin1;\r\nlet pans : list = listin2;\r\n\r\nfor(let i=0; i<16; i++){\r\n    \r\n    let base = vols[i] * 2;\r\n    let left = base * (1.0 - pans[i]);\r\n    let right = base * (pans[i]);\r\n    \r\n    let index = (i + 1) * 2\r\n    listout1 = [index - 2, left];\r\n    listout2 = [index - 1, right];\r\n}",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-1",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [ "", "" ],
                    "patching_rect": [ 71.0, 90.0, 340.0, 313.0 ],
                    "rnbo_classname": "codebox",
